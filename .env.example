# ── Image version (Docker Hub tag, e.g. latest, 1.0.0) ──
OBLIPLAN_VERSION=latest

# ── Database ──
# Built-in postgres container (docker-compose.yml):
DB_PASSWORD=changeme
# External PostgreSQL: set DATABASE_URL instead and drop the postgres service.
# DATABASE_URL=postgres://obliplan:yourpassword@your-db-host:5432/obliplan

# ── Server ──
PORT=3003
NODE_ENV=production
SESSION_SECRET=change-this-to-a-random-32-char-secret

# ── Client origin (CORS — set to your actual URL) ──
CLIENT_ORIGIN=http://localhost
LISTEN_PORT=3002

# ── HTTPS deployments (REQUIRED behind an HTTPS reverse proxy) ──
# Enables Secure + SameSite=None + Partitioned cookies — required for the
# Obligate OAuth callback and ObliTools iframe contexts over HTTPS.
# FORCE_HTTPS=true

# ── App ──
APP_NAME=Obliplan
# Public base URL of the app — used for ICS subscribe links, push & e-mail links.
# Set to your REAL URL, e.g. https://planning.mondomaine.fr
APP_URL=http://localhost

# ── Default admin (created on first run, local-auth mode) ──
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ── Web Push (PWA notifications) — OPTIONAL ──
# Push stays DISABLED until BOTH keys are set. Generate a keypair once on any
# machine with Node:  npx web-push generate-vapid-keys
# Only the SERVER needs these — the browser fetches the public key at runtime
# from /api/push/public-key (no client rebuild required).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.fr

# ── Audit log — OPTIONAL (falls back to SESSION_SECRET if unset) ──
# Dedicated HMAC key for the tamper-evident audit trail. Keep it STABLE across
# restarts, or existing audit entries fail integrity verification.
# AUDIT_LOG_SECRET=
